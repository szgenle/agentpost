    <string name="settings_save_self">保存 SELF</string>
    <string name="settings_save_agent">保存 AGENT</string>
    <string name="settings_test_connection">测试拉取</string>

    <!-- 动态提示：%1$s = 错误信息 -->
    <string name="settings_msg_save_failed">保存失败：%1$s</string>
    <!-- %1$d = 新邮件数量 -->
    <string name="settings_msg_test_success">连接成功，拉到 %1$d 封新邮件</string>
    <!-- %1$s = 错误信息 -->
    <string name="settings_msg_test_failed">连接失败：%1$s</string>

    <!-- 缺失账户时的提示：%1$s = 已保存账户标签（SELF/AGENT）。
         拆成两条独立文案而不是运行时拼接，方便翻译审校、避免 ViewModel 持 Context。 -->
    <string name="settings_msg_saved_missing_self">%1$s 已保存，请继续配置自己的邮箱 SELF 后才能拉取邮件</string>
    <string name="settings_msg_saved_missing_agent">%1$s 已保存，请继续配置 AI 的邮箱 AGENT 后才能拉取邮件</string>
    <!-- %1$s = 已保存账户标签 -->
    <string name="settings_msg_saved_syncing">%1$s 已保存，正在拉取邮件……</string>
    <!-- %1$s = 已保存账户标签，%2$d = 新邮件数 -->
    <string name="settings_msg_saved_synced">%1$s 已保存，拉到 %2$d 封新邮件</string>
    <!-- %1$s = 已保存账户标签，%2$s = 错误信息 -->
    <string name="settings_msg_saved_sync_failed">%1$s 已保存，但拉取失败：%2$s</string>

    <!-- 语言切换：选项名用各自语言的定名，translatable=false -->
    <string name="settings_language_section">语言</string>
    <string name="settings_language_zh" translatable="false">中文</string>
    <string name="settings_language_en" translatable="false">English</string>
