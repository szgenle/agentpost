    <!-- Merge strategy dialog -->
    <string name="settings_config_io_strategy_title">How should we merge?</string>
    <string name="settings_config_io_strategy_overwrite">Overwrite</string>
    <string name="settings_config_io_strategy_overwrite_desc">Same-typed accounts/templates are overwritten; preferences (intervals, crash reports) are also overwritten. Mailbox passwords are untouched.</string>
    <string name="settings_config_io_strategy_merge">Add new only</string>
    <string name="settings_config_io_strategy_merge_desc">Only write accounts and templates that don\'t exist locally; preferences untouched.</string>
    <string name="settings_config_io_strategy_skip">Skip existing</string>
    <string name="settings_config_io_strategy_skip_desc">Skip when a same-type account or same (title, subject) template already exists; preferences untouched.</string>
