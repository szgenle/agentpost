    <!-- ====== Config import/export (sub page) ====== -->
    <string name="settings_row_config_io">Config import / export</string>
    <string name="settings_row_config_io_desc">Pack your identities, command templates and more into an encrypted ZIP for migration or backup.</string>
    <string name="settings_config_io_title">Config import / export</string>
    <string name="settings_config_io_intro">Export includes the SELF / AGENT identities, IMAP/SMTP settings (without passwords), command templates, fetch intervals and crash report preference. Mailbox passwords and the attachment master password itself are never exported. The ZIP is encrypted with the "Attachment decrypt password" from Settings.</string>
    <string name="settings_config_io_section_export">Export</string>
    <string name="settings_config_io_section_import">Import</string>
    <string name="settings_config_io_export_row">Export to encrypted ZIP</string>
    <string name="settings_config_io_export_desc">After choosing a location an encrypted ZIP will be written; the file name carries a timestamp.</string>
    <string name="settings_config_io_import_row">Import from encrypted ZIP</string>
    <string name="settings_config_io_import_desc">After picking a file you\'ll confirm a merge strategy.</string>
    <string name="settings_config_io_busy">Working…</string>

