<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMTP/IMAP 网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 局域网在场广播：获取 WiFi IP / 网络变化监听 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 13+ 发通知需要运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 实时推送用的前台服务（IMAP IDLE 长连），Android 14+ 必须声明子类型 dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 软引导用户加入电池白名单：仅跳系统设置，不直接申请 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启：恢复实时推送 / 局域网在场广播的前台服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 保持 CPU 唤醒以维持 IMAP IDLE 长连接 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AgentPostApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.AgentPost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AgentPost">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 实时推送前台服务：开启"实时通知"开关后常驻，用 IMAP IDLE 秒级感知新邮件。
             foregroundServiceType="dataSync"：唯一匹配 IMAP 长连语义的类型。 -->
        <service
            android:name=".sync.PushSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- 开机自启：手机重启后自动恢复前台服务 -->
        <receiver
            android:name=".sync.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 附件文件共享给外部 app 打开用。
             authority 统一用 "${applicationId}.fileprovider"；路径白名单见 res/xml/file_paths.xml。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
